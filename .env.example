# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Секреты не коммитить.

# --- Обязательное ---
SECRET_KEY=
PUBLIC_BASE_URL=https://dataroom.example.com
DATABASE_URL=postgres://dataroom:CHANGE_ME@db:5432/dataroom
POSTGRES_DB=dataroom
POSTGRES_USER=dataroom
POSTGRES_PASSWORD=CHANGE_ME

# --- Бренд и язык экземпляра ---
SITE_NAME=Data Room
LOGO=
BRAND_COLOR=#235244
# ru, uk, de или en. Если не задан, используется en.
DEFAULT_LOCALE=en

# --- Безопасность ---
# 1, только если перед приложением стоит ваш reverse proxy с X-Forwarded-Proto.
TRUST_PROXY_HEADERS=1
# Отдельные имена cookie для каждого экземпляра на одном домене верхнего уровня.
SESSION_COOKIE_NAME=dataroom_session
CSRF_COOKIE_NAME=dataroom_csrf
# Дополнительные допустимые хосты через запятую (обычно пусто).
ALLOWED_HOSTS_EXTRA=

# --- Почта (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# --- Файлы ---
PRIVATE_MEDIA_ROOT=/data/private_media
MAX_UPLOAD_BYTES=52428800
