msgstr "Поки ні в кого немає доступу."

msgid "Only PDF, DOCX and XLSX files are accepted."
msgstr "Приймаються лише файли PDF, DOCX і XLSX."

msgid "Only an empty folder can be deleted."
msgstr "Видалити можна лише порожню папку."

msgid "Optional. Access ends at the end of this day (UTC)."
msgstr "Необов’язково. Доступ закінчується наприкінці цього дня (UTC)."

msgid "PDF, DOCX or XLSX."
msgstr "PDF, DOCX або XLSX."

msgid "Person"
msgstr "Особа"

msgid "Product and technology"
msgstr "Продукт і технології"

