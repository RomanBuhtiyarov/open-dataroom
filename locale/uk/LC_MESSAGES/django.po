msgstr "Опис"

msgid "Documents"
msgstr "Документи"

msgid "Download"
msgstr "Завантажити"

msgid "Downloading originals is not enabled for your access."
msgstr "Завантаження оригіналів для вашого доступу не ввімкнено."

