msgstr "Папки"

msgid "Folders are nested too deeply."
msgstr "Забагато рівнів вкладеності папок."

msgid "Grant access"
msgstr "Надати доступ"

msgid "I have read the NDA and accept it"
msgstr "Я прочитав(ла) угоду і приймаю її"

msgid "IT and security"
msgstr "ІТ і безпека"

msgid "Intellectual property"
msgstr "Інтелектуальна власність"

msgid "Leave empty to use the file name."
msgstr "Залиште порожнім, щоб використати назву файлу."

msgid "Legal"
msgstr "Юридичні питання"

msgid "Legal and corporate"
msgstr "Юридичні та корпоративні документи"

msgid "NDA"
msgstr "NDA"

msgid "New room"
msgstr "Нова кімната"

msgid "New version"
msgstr "Нова версія"

