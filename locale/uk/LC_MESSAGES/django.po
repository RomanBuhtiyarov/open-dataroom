msgstr "Вимагати від відвідувачів прийняти NDA"

msgid "Revoke"
msgstr "Відкликати"

msgid "Room name"
msgstr "Назва кімнати"

msgid "Summary and pitch deck"
msgstr "Резюме та презентація"

msgid "Tax"
msgstr "Податки"

msgid "Team"
msgstr "Команда"

msgid "Template applied. New folders: %(count)d."
msgstr "Шаблон застосовано. Нових папок: %(count)d."

msgid ""
"The NDA is not required for this room. Turn it on in the room settings."
msgstr ""
"Для цієї кімнати NDA не потрібна. Увімкніть цю вимогу в налаштуваннях "
"кімнати."

msgid ""
"The confidentiality agreement is not available yet. Please try again later."
msgstr "Угода про конфіденційність поки недоступна. Спробуйте пізніше."

msgid "The document is uploaded."
msgstr "Документ завантажено."

msgid "The end date must be in the future."
msgstr "Дата завершення має бути в майбутньому."

