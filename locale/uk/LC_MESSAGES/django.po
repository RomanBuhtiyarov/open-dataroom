msgstr "Файли з макросами не приймаються."

msgid "Financial"
msgstr "Фінанси"

msgid "Financials"
msgstr "Фінансова звітність"

msgid "Folder"
msgstr "Папка"

msgid "Folder name"
msgstr "Назва папки"

