msgstr "Папку створено."

msgid "The folder is deleted."
msgstr "Папку видалено."

msgid "The folder is renamed."
msgstr "Папку перейменовано."

msgid "The new NDA version is published. Everyone must accept it again."
msgstr "Нову версію угоди опубліковано. Усі мають прийняти її знову."

msgid "The room is created."
msgstr "Кімнату створено."

msgid "The room is saved."
msgstr "Кімнату збережено."

msgid "The text in the default language of the instance is required."
msgstr "Потрібен текст мовою екземпляра за замовчуванням."

